# Copia el host exacto desde Supabase: Connect > Session pooler.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres"

# Secreto largo y aleatorio para firmar los JWT. Nunca lo subas a GitHub.
JWT_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio"

# Puerto local. En Render la plataforma inyecta PORT automáticamente.
PORT=3000